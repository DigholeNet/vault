[Unit]
PartOf=edge.target
Documentation=man:edge(1)

[Service]
Type=forking
User=vault
Group=vault
UMask=0027
ExecStart=/usr/bin/edge --config /etc/vault/edge.toml --daemon --log-dir /var/log/vault/ --pid-file /run/edge.pid
PIDFile=/run/edge.pid
WorkingDirectory=/etc/vault
RestartSec=5s
Restart=on-failure
TasksMax=256
MemoryMax=1024M
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# /etc/resolv.conf is needed for the DNS takeover (no-op if it is a
# symlink into /run, which is already covered).
StateDirectory=vault
LogsDirectory=vault
ReadWritePaths=/var/log/vault /run /etc/resolv.conf
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
