[Unit]
PartOf=edge.target
Documentation=man:edge(1)

[Service]
Type=forking
ExecStart=/usr/bin/edge --config /etc/vault/edge.toml --daemon --log-dir /var/log/vault/ --pid-file /run/edge.pid
PIDFile=/run/edge.pid
WorkingDirectory=/etc/vault
RestartSec=5s
Restart=on-failure
TasksMax=256
MemoryMax=1024M
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# /var/lib/vault is created and kept writable via StateDirectory;
# /etc/resolv.conf is needed for the DNS takeover (no-op if it is a
# symlink into /run, which is already covered).
StateDirectory=vault
ReadWritePaths=/var/log /run /etc/resolv.conf
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SETGID CAP_SETUID CAP_SYS_CHROOT CAP_DAC_OVERRIDE CAP_SYS_ADMIN
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
