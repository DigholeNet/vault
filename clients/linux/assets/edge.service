[Unit]
PartOf=edge.target
Documentation=man:edge(1)
After=systemd-resolved.service

[Service]
Type=forking
User=vault
Group=vault
UMask=0027
ExecStart=/usr/bin/edge --config /etc/vault/edge.toml --daemon --log-dir /var/log/vault/ --pid-file /run/edge.pid
PIDFile=/run/edge.pid
RestartSec=5s
Restart=on-failure
TasksMax=256
MemoryMax=1024M
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
StateDirectory=vault
LogsDirectory=vault
ReadWritePaths=/var/log/vault /run
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
