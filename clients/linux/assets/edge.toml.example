iface="vpn"
storage="/var/lib/vault/storage.dat"
default_profile="main"

[profiles.main]
password="your_password"
port=9527
host="your_server_ip"
dns_ipv4=["1.1.1.1", "8.8.8.8"]
dns_ipv6=["2001:4860:4860::8888", "2001:4860:4860::8844"]

[profiles.backup]
password="backup_password"
port=9527
host="backup_server_ip"
dns_ipv4=["1.1.1.1", "8.8.8.8"]
dns_ipv6=["2001:4860:4860::8888", "2001:4860:4860::8844"]
