<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageButton
            android:id="@+id/btnToggleVpn"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_disconnected"
            android:contentDescription="@string/toggle_vpn_description" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/status_off"
            android:textColor="#F44336"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatusDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/status_tap_to_connect"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvIpv4Address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text=""
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvIpv6Address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSentStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text=""
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvReceivedStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
