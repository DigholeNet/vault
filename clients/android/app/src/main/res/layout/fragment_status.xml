<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/app_name" android:textAppearance="@style/TextAppearance.Vault.PageTitle"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/status_page_subtitle"
                    android:textAppearance="@style/TextAppearance.Vault.Supporting"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/headerStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/vault_bg_badge"
                android:backgroundTint="@color/vault_surface_subtle"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <View
                    android:id="@+id/headerStatusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/vault_bg_status_dot"/>
                <TextView
                    android:id="@+id/tvHeaderStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_off"
                    android:textColor="@color/vault_blue_dark"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnProfile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/vault_bg_profile"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_server_rack"
                app:tint="@color/vault_blue"/>
            <TextView
                android:id="@+id/btnProfileText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/add_profile"
                android:textColor="@color/vault_text"
                android:textSize="13sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/switch_profile_short"
                android:textColor="@color/vault_text_disabled"
                android:textSize="10sp"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron"
                app:tint="@color/vault_text_disabled"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statusHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="224dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/vault_bg_hero_neutral"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="20dp">
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_off"
                android:textColor="@color/vault_text_secondary"
                android:minHeight="24dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textSize="21sp"
                android:textStyle="bold"/>
            <FrameLayout
                android:id="@+id/connectionControl"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginTop="12dp">
                <ImageButton
                    android:id="@+id/btnToggleVpn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/vault_bg_connection_button_neutral"
                    android:contentDescription="@string/toggle_vpn_description"
                    android:padding="19dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_disconnected"/>
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/connectionProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/status_progress"
                    app:indicatorInset="0dp"
                    app:indicatorSize="50dp"
                    app:trackColor="@android:color/transparent"
                    app:trackThickness="4dp"/>
            </FrameLayout>
            <TextView
                android:id="@+id/connectionDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:includeFontPadding="false"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:textColor="@color/vault_hero_text"
                android:textSize="26sp"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/tvConnectionAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:includeFontPadding="false"
                android:text="@string/status_tap_to_connect"
                android:textColor="@color/vault_blue"
                android:textSize="15sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvStatusDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:gravity="center"
                android:textColor="@color/vault_text_secondary"
                android:textSize="12sp"
                android:visibility="gone"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/readyCard"
            style="@style/Widget.Vault.InfoCallout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="top" android:orientation="horizontal" android:padding="18dp">
                <ImageView android:layout_width="30dp" android:layout_height="30dp"
                    android:importantForAccessibility="no" android:padding="5dp"
                    android:src="@drawable/ic_info" app:tint="@color/vault_blue"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/ready_to_connect"
                        android:textAppearance="@style/TextAppearance.Vault.InfoCalloutTitle"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="@string/ready_to_connect_detail"
                        android:textAppearance="@style/TextAppearance.Vault.Supporting"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/networkCard"
            style="@style/Widget.Vault.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingHorizontal="18dp" android:paddingVertical="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/network_details" android:textAppearance="@style/TextAppearance.Vault.CardTitle"/>
                <LinearLayout
                    android:id="@+id/publicIpSection"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:gravity="center_vertical"
                    android:orientation="horizontal" android:visibility="gone">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:importantForAccessibility="no" android:src="@drawable/ic_public_ip"
                        app:tint="@color/vault_blue"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:text="@string/status_wan"
                        android:textAppearance="@style/TextAppearance.Vault.Supporting"/>
                    <TextView android:id="@+id/tvPublicIpAddress" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_marginStart="12dp"
                        android:layout_weight="1" android:fontFamily="monospace" android:gravity="end"
                        android:textColor="@color/vault_text" android:textIsSelectable="true" android:includeFontPadding="false" android:textSize="12sp"/>
                </LinearLayout>
                <View android:id="@+id/networkDivider" android:layout_width="match_parent"
                    android:layout_height="1dp" android:layout_marginVertical="7dp"
                    android:background="@color/vault_outline" android:visibility="gone"/>
                <LinearLayout android:id="@+id/ipAddresses" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:id="@+id/rowIpv4" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="6dp"
                        android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:importantForAccessibility="no" android:src="@drawable/ic_server_rack"
                            app:tint="@color/status_downlink"/>
                        <TextView android:id="@+id/labelIpv4" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="10dp"
                            android:text="IPv4" android:textAppearance="@style/TextAppearance.Vault.Supporting"/>
                        <TextView android:id="@+id/tvIpv4Address" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp"
                            android:layout_weight="1" android:fontFamily="monospace" android:gravity="end"
                            android:textColor="@color/vault_text" android:textIsSelectable="true" android:includeFontPadding="false" android:textSize="12sp"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/rowIpv6" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:importantForAccessibility="no" android:src="@drawable/ic_server_rack"
                            app:tint="@color/vault_blue"/>
                        <TextView android:id="@+id/labelIpv6" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="10dp"
                            android:text="IPv6" android:textAppearance="@style/TextAppearance.Vault.Supporting"/>
                        <TextView android:id="@+id/tvIpv6Address" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp"
                            android:layout_weight="1" android:fontFamily="monospace" android:gravity="end"
                            android:textColor="@color/vault_text" android:textIsSelectable="true" android:includeFontPadding="false" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/connectionInfo"
            style="@style/Widget.Vault.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingHorizontal="18dp" android:paddingVertical="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/live_traffic" android:textAppearance="@style/TextAppearance.Vault.CardTitle"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:baselineAligned="false" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:importantForAccessibility="no" android:src="@drawable/ic_uplink"/>
                            <TextView android:id="@+id/labelSent" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:layout_marginStart="6dp"
                                android:text="@string/uplink" android:textAppearance="@style/TextAppearance.Vault.Supporting"/>
                        </LinearLayout>
                        <TextView android:id="@+id/tvSentSpeed" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginTop="5dp"
                            android:fontFamily="monospace" android:text="0.00 B/s"
                            android:textColor="@color/status_uplink" android:includeFontPadding="false" android:textSize="17sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvSentBytes" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginTop="4dp"
                            android:text="0.00 B" android:textAppearance="@style/TextAppearance.Vault.Supporting"/>
                        <TextView android:id="@+id/tvSentPackets" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.Vault.Supporting"/>
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="80dp"
                        android:layout_gravity="center_vertical" android:background="@color/vault_outline"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:importantForAccessibility="no" android:src="@drawable/ic_downlink"/>
                            <TextView android:id="@+id/labelReceived" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:layout_marginStart="6dp"
                                android:text="@string/downlink" android:textAppearance="@style/TextAppearance.Vault.Supporting"/>
                        </LinearLayout>
                        <TextView android:id="@+id/tvReceivedSpeed" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginTop="5dp"
                            android:fontFamily="monospace" android:text="0.00 B/s"
                            android:textColor="@color/status_downlink" android:includeFontPadding="false" android:textSize="17sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvReceivedBytes" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginTop="4dp"
                            android:text="0.00 B" android:textAppearance="@style/TextAppearance.Vault.Supporting"/>
                        <TextView android:id="@+id/tvReceivedPackets" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.Vault.Supporting"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
