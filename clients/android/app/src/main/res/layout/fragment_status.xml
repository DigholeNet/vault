<?xml version="1.0" ?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/status_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="32sp"
            android:includeFontPadding="false"
            android:text="@string/status_off"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"/>
        <ImageButton
            android:id="@+id/btnToggleVpn"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="80dp"
            android:background="@drawable/connection_background"
            android:padding="8dp"
            android:elevation="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_disconnected"
            android:contentDescription="@string/toggle_vpn_description"/>
        <TextView
            android:id="@+id/tvStatusDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:includeFontPadding="false"
            android:layout_marginTop="20dp"
            android:textColor="@color/connection_disconnected"
            android:gravity="center"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/connectionDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingVertical="4dp"
            android:gravity="center"
            android:textSize="32sp"
            android:fontFamily="sans-serif-light"
            android:fontFeatureSettings="tnum"
            android:letterSpacing="0.0625"
            android:includeFontPadding="false"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/networkCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:strokeWidth="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">
                <LinearLayout
                    android:id="@+id/publicIpSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_public_ip"
                            app:tint="?attr/colorPrimary"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:includeFontPadding="false"
                            android:text="@string/status_public_ip"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvPublicIpAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="none"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textIsSelectable="true"
                        android:textSize="14sp"
                        app:autoSizeMaxTextSize="14sp"
                        app:autoSizeMinTextSize="10sp"
                        app:autoSizeStepGranularity="0.5sp"
                        app:autoSizeTextType="uniform"/>
                </LinearLayout>
                <View
                    android:id="@+id/networkDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="?attr/colorOutlineVariant"
                    android:visibility="gone"/>
                <LinearLayout
                    android:id="@+id/ipAddresses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/rowIpv4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_server_rack"
                            app:tint="@color/status_uplink"/>
                        <TextView
                            android:id="@+id/labelIpv4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:includeFontPadding="false"
                            android:text="IPv4"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/tvIpv4Address"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="none"
                            android:fontFamily="monospace"
                            android:gravity="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurface"
                            android:textIsSelectable="true"
                            android:textSize="14sp"
                            app:autoSizeMaxTextSize="14sp"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeStepGranularity="0.5sp"
                            app:autoSizeTextType="uniform"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/rowIpv6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_server_rack"
                            app:tint="@color/status_downlink"/>
                        <TextView
                            android:id="@+id/labelIpv6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:includeFontPadding="false"
                            android:text="IPv6"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/tvIpv6Address"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="none"
                            android:fontFamily="monospace"
                            android:gravity="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurface"
                            android:textIsSelectable="true"
                            android:textSize="14sp"
                            app:autoSizeMaxTextSize="14sp"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeStepGranularity="0.5sp"
                            app:autoSizeTextType="uniform"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout
            android:id="@+id/connectionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_uplink"
                            android:importantForAccessibility="no"/>
                        <TextView
                            android:id="@+id/labelSent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:includeFontPadding="false"
                            android:text="@string/uplink"
                            android:layout_marginStart="4dp"
                            android:textColor="?android:attr/textColorSecondary"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvSentSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:text="0.00 B/s"
                        android:textColor="@color/status_uplink"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tvSentBytes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:includeFontPadding="false"
                        android:text="0.00 B"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp"/>
                    <TextView
                        android:id="@+id/tvSentPackets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:includeFontPadding="false"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp"/>
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="70dp"
                    android:background="?attr/colorOutlineVariant"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_downlink"
                            android:importantForAccessibility="no"/>
                        <TextView
                            android:id="@+id/labelReceived"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:includeFontPadding="false"
                            android:text="@string/downlink"
                            android:layout_marginStart="4dp"
                            android:textColor="?android:attr/textColorSecondary"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvReceivedSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:text="0.00 B/s"
                        android:textColor="@color/status_downlink"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tvReceivedBytes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:includeFontPadding="false"
                        android:text="0.00 B"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp"/>
                    <TextView
                        android:id="@+id/tvReceivedPackets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:includeFontPadding="false"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
