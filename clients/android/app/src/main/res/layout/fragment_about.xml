<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_horizontal" android:orientation="vertical"
        android:paddingHorizontal="@dimen/vault_page_inset" android:paddingBottom="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/nav_about" android:textAppearance="@style/TextAppearance.Vault.PageTitle"/>
        <com.google.android.material.imageview.ShapeableImageView android:layout_width="72dp"
            android:layout_height="72dp" android:layout_marginTop="44dp"
            android:importantForAccessibility="no" android:scaleType="fitCenter" android:src="@mipmap/ic_launcher"
            app:shapeAppearanceOverlay="@style/AboutAppIconShape"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/app_name"
            android:textColor="@color/vault_text" android:textSize="30sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvVersion" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center"
            android:text="@string/version_unknown" android:textAppearance="@style/TextAppearance.Vault.Supporting"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:gravity="center"
            android:text="@string/about_description" android:textAppearance="@style/TextAppearance.Vault.Body"/>
        <androidx.appcompat.widget.AppCompatTextView android:id="@+id/tvWebsite" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp"
            android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"
            android:gravity="center" android:paddingHorizontal="4dp"
            android:drawablePadding="8dp" app:drawableStartCompat="@drawable/ic_globe"
            app:drawableTint="@color/vault_blue"
            android:text="@string/website" android:textColor="@color/vault_blue"
            android:textDirection="ltr" android:textSize="14sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/copyright"
            android:textAppearance="@style/TextAppearance.Vault.Supporting"/>
    </LinearLayout>
</ScrollView>
