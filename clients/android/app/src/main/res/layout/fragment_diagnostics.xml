<?xml version="1.0" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/diagnosticTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:id="@+id/checksPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/tvDiagnosticSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Vault.Diagnostics.Body"/>
            <TextView
                android:id="@+id/tvDiagnosticElapsed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:visibility="gone"
                android:textAppearance="@style/TextAppearance.Vault.Diagnostics.Secondary"
                android:fontFeatureSettings="tnum"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRunChecks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@string/run_checks"/>
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/diagnosticProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"/>
            <LinearLayout
                android:id="@+id/diagnosticRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/ping_note"
                android:textAppearance="@style/TextAppearance.Vault.Diagnostics.Secondary"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/logsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:id="@+id/logScroll">
            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:padding="8dp"
                android:scrollHorizontally="false"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"/>
        </ScrollView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end">
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:id="@+id/btnClearLogs"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/clear"
                android:minWidth="56dp"
                android:minHeight="48dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:textSize="12sp"
                android:letterSpacing="0"
                android:insetTop="8dp"
                android:insetBottom="8dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:enabled="false"
                app:cornerRadius="8dp"
                app:strokeWidth="1dp"
                app:iconSize="14dp"
                app:iconPadding="4dp"
                app:iconGravity="textStart"
                app:icon="@drawable/ic_log_clear"/>
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:id="@+id/btnCopyLogs"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/copy"
                android:minWidth="56dp"
                android:minHeight="48dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:textSize="12sp"
                android:letterSpacing="0"
                android:insetTop="8dp"
                android:insetBottom="8dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:enabled="false"
                app:cornerRadius="8dp"
                app:strokeWidth="1dp"
                app:iconSize="14dp"
                app:iconPadding="4dp"
                app:iconGravity="textStart"
                app:icon="@drawable/ic_log_copy"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
