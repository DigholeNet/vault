#!/bin/sh
set -e

if ! getent group vault >/dev/null; then
    addgroup --system vault
fi
if ! getent passwd vault >/dev/null; then
    adduser --system --ingroup vault --no-create-home --home /var/lib/vault --disabled-login vault
fi

install -d -o vault -g vault -m 750 /var/log/vault
for path in /var/log/vault/* /var/log/vault/.[!.]* /var/log/vault/..?*; do
    if [ -f "$path" ] || [ -L "$path" ]; then
        chown -h vault:vault "$path"
    fi
done

systemctl daemon-reload
chmod 700 /etc/vault
