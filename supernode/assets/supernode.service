[Unit]
PartOf=supernode.target
Documentation=man:supernode(1)

[Service]
Type=forking
ExecStart=/usr/bin/supernode --config /etc/vault/supernode.toml --daemon --log-dir /var/log/vault/ --pid-file /run/supernode.pid
PIDFile=/run/supernode.pid
WorkingDirectory=/etc/vault
RestartSec=5s
Restart=on-failure
TasksMax=256
MemoryMax=1024M
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/log /run
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SETGID CAP_SETUID CAP_SYS_CHROOT CAP_DAC_OVERRIDE CAP_SYS_ADMIN
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
