[Unit]
PartOf=supernode.target
Documentation=man:supernode(1)

[Service]
Type=forking
User=vault
Group=vault
UMask=0027
ExecStart=/usr/bin/supernode --config /etc/vault/supernode.toml --daemon --log-dir /var/log/vault/ --pid-file /run/supernode.pid
PIDFile=/run/supernode.pid
WorkingDirectory=/etc/vault
RestartSec=5s
Restart=on-failure
TasksMax=256
MemoryMax=1024M
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
LogsDirectory=vault
ReadWritePaths=/var/log/vault /run
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_DAC_OVERRIDE
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
